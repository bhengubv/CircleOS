# Amarula product bluetooth vendor config.
# Forwards to vendor/hihope/rk3568/bluetooth — the actual HiHope rk3568
# bluetooth firmware and HAL source. The hihope board ohos.build expects
# these targets at vendor/hihope/${product_name}/bluetooth.

import("//build/ohos.gni")
import("//build/ohos/ndk/ndk.gni")

config("bt_warnings") {
  cflags = [
    "-Wall",
    "-Werror",
    "-Wno-switch",
    "-Wno-unused-function",
    "-Wno-unused-parameter",
    "-Wno-unused-variable",
    "-Wno-implicit-function-declaration",
    "-Wno-incompatible-pointer-types",
    "-Wno-unused-but-set-variable",
  ]
}

ohos_prebuilt_etc("BCM4362A2.hcd") {
  source = "//vendor/hihope/rk3568/bluetooth/BCM4362A2.hcd"
  install_images = [ chipset_base_dir ]
  relative_install_dir = "firmware"
  part_name = "rockchip_products"
  install_enable = true
}

ohos_shared_library("libbt_vendor") {
  output_name = "libbt_vendor"
  sources = [
    "//vendor/hihope/rk3568/bluetooth/src/bt_vendor_brcm.c",
    "//vendor/hihope/rk3568/bluetooth/src/conf.c",
    "//vendor/hihope/rk3568/bluetooth/src/hardware.c",
    "//vendor/hihope/rk3568/bluetooth/src/upio.c",
    "//vendor/hihope/rk3568/bluetooth/src/userial_vendor.c",
  ]

  include_dirs = [
    "//vendor/hihope/rk3568/bluetooth/include",
    "//base/hiviewdfx/hilog/interfaces/native/innerkits/include",
  ]

  cflags = [
    "-DUSE_CONTROLLER_BDADDR=TRUE",
    "-DFW_AUTO_DETECTION=TRUE",
    "-DBT_WAKE_VIA_PROC=FALSE",
    "-DSCO_PCM_ROUTING=0",
    "-DSCO_PCM_IF_CLOCK_RATE=1",
    "-DSCO_PCM_IF_FRAME_TYPE=0",
    "-DSCO_PCM_IF_SYNC_MODE=0",
    "-DSCO_PCM_IF_CLOCK_MODE=0",
    "-DPCM_DATA_FMT_SHIFT_MODE=0",
    "-DPCM_DATA_FMT_FILL_BITS=0x03",
    "-DPCM_DATA_FMT_FILL_METHOD=0",
    "-DPCM_DATA_FMT_FILL_NUM=0",
    "-DPCM_DATA_FMT_JUSTIFY_MODE=0",
  ]

  configs = [ ":bt_warnings" ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
  ]

  install_enable = true
  install_images = [ chipset_base_dir ]

  part_name = "rockchip_products"
  subsystem_name = "device_rk3568"
}
