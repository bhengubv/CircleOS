/*
 * Copyright (C) 2026 The Other Bhengu (PTY) Ltd t/a The Geek Network.
 *
 * AIDL surface for the Circle SDPKT Titanium wallet service.
 *
 * SDPKT Titanium = the OS-level wallet that holds the user's signing
 * keys inside Keymaster/StrongBox (the device's TEE — Trusted Execution
 * Environment). The private key never leaves the secure element; the
 * service signs transactions on the caller's behalf after enforcing
 * lock-screen authentication.
 *
 * Capabilities:
 *   - Hold an ed25519 signing identity in the TEE
 *   - Sign outbound transactions
 *   - Maintain an offline transaction log (TXs that occur without
 *     internet — settled against the central ledger when back online)
 *   - NFC peer-to-peer payment between two SDPKT devices in physical
 *     proximity
 *   - Multi-device pairing (one wallet, several devices)
 *   - Lock-screen quick-pay (one-tap pay without unlocking)
 *
 * Permissions:
 *   - USE_SDPKT: send transactions, read balance
 *   - QUERY_SDPKT: read balance + tx history (status UI)
 *   - MANAGE_SDPKT: pair new device, change device limits
 *     (signature|privileged)
 *
 * Authentication: any sendOfflineTx / sendNfcTx call triggers a
 * lock-screen biometric/PIN prompt. The service refuses to sign without
 * a successful auth result within the prior 30 seconds.
 */

package za.co.circleos.sdpkt;

import za.co.circleos.sdpkt.WalletInfo;
import za.co.circleos.sdpkt.OfflineTransaction;
import za.co.circleos.sdpkt.DeviceLink;
import za.co.circleos.sdpkt.IBalanceChangeListener;

/** Binder published under SERVICE_NAME = "circle_sdpkt". */
interface ICircleSdpktManager {

    // ----- identity ---------------------------------------------------

    /**
     * Wallet identifier — ed25519 public-key fingerprint, hex (64 chars).
     * Stable across boots and devices paired to the same wallet.
     */
    String getWalletId();

    /** Cheap metadata snapshot — balance, currency, last sync. */
    WalletInfo getWalletInfo();

    // ----- balance / history -----------------------------------------

    /** Balance in cents (or smallest unit). */
    long getBalance();

    /** Last N transactions, most recent first. */
    OfflineTransaction[] getRecentTransactions(int limit);

    /** Transactions awaiting settlement (offline / queued). */
    OfflineTransaction[] getOfflineTxQueue();

    // ----- send -------------------------------------------------------

    /**
     * Send an offline-capable transaction. Signed in the TEE; queued for
     * settlement when network reachability returns.
     *
     * Requires USE_SDPKT and a fresh lock-screen auth (< 30 s old).
     *
     * @param targetWalletId  recipient ed25519 fingerprint
     * @param amountCents     positive integer; clamped to per-device cap
     * @param memo            optional human-readable memo, <= 64 chars
     * @return transaction id (uuid hex) — survives across boots once
     *         queued
     */
    String sendOfflineTx(in String targetWalletId, long amountCents, in String memo);

    /**
     * Send a transaction via NFC P2P. The TEE signs and the OS hands the
     * signed envelope to the NFC stack for delivery to the device the
     * user has tapped. Requires both devices to expose SDPKT over NFC.
     */
    String sendNfcTx(long amountCents, in String memo);

    // ----- pairing ----------------------------------------------------

    /** Devices currently linked to this wallet. */
    DeviceLink[] listLinkedDevices();

    /**
     * Pair a new device using a QR payload generated by that device's
     * onboarding flow. Requires MANAGE_SDPKT + fresh lock-screen auth.
     */
    void pairNewDevice(in String qrPayload);

    /** Revoke a previously-linked device by its DeviceLink.id. */
    void revokeDevice(in String deviceLinkId);

    // ----- subscriptions ---------------------------------------------

    long subscribeBalanceChanges(in IBalanceChangeListener listener);
    void unsubscribeBalanceChanges(long handle);

    // ----- versioning ------------------------------------------------

    int getApiVersion();
}
