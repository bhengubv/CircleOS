<?xml version="1.0" encoding="utf-8"?>
<!--
  Circle OS spacing + sizing tokens.

  Apps and the shell reference these by name instead of magic dp
  values, so a single Elder-tier overlay can scale everything by
  multiplying the base unit.
-->
<resources>

    <!-- Base unit. All other spacings are multiples of this. -->
    <dimen name="circle_unit">4dp</dimen>

    <!-- Spacing scale: x1..x8 of base unit -->
    <dimen name="circle_space_xxs">2dp</dimen>
    <dimen name="circle_space_xs">4dp</dimen>
    <dimen name="circle_space_sm">8dp</dimen>
    <dimen name="circle_space_md">16dp</dimen>
    <dimen name="circle_space_lg">24dp</dimen>
    <dimen name="circle_space_xl">32dp</dimen>
    <dimen name="circle_space_xxl">48dp</dimen>

    <!-- Touch target floor (a11y baseline; Elder tier scales up). -->
    <dimen name="circle_touch_target">48dp</dimen>
    <dimen name="circle_touch_target_elder">64dp</dimen>

    <!-- Type ramp. Base sizes; Elder tier scales by 1.4x in overlay. -->
    <dimen name="circle_text_caption">12sp</dimen>
    <dimen name="circle_text_body">15sp</dimen>
    <dimen name="circle_text_title">19sp</dimen>
    <dimen name="circle_text_headline">24sp</dimen>
    <dimen name="circle_text_display">36sp</dimen>

    <!-- Card / sheet corners. Soft-but-not-bubbly. -->
    <dimen name="circle_corner_sm">6dp</dimen>
    <dimen name="circle_corner_md">12dp</dimen>
    <dimen name="circle_corner_lg">20dp</dimen>

    <!-- Elevation tokens (we render with shadow, not blur). -->
    <dimen name="circle_elev_flat">0dp</dimen>
    <dimen name="circle_elev_low">2dp</dimen>
    <dimen name="circle_elev_med">6dp</dimen>
    <dimen name="circle_elev_high">12dp</dimen>

</resources>
