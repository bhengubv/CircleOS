<?xml version="1.0" encoding="utf-8"?>
<!--
  Base Circle OS theme.

  Apps that want the Circle look inherit Theme.CircleOS in their own
  AndroidManifest.xml. The base picks brand colours and Comfortaa as
  the primary type face; the night-mode variant is auto-picked by
  Android when the user is in Dark Mode (or in the Night personality
  mode).

  Per-mode overlays live in mode-overlays/<mode>/ as separate APKs
  applied via OverlayManager — see vendor/circle/design/overlays/
  (to be added).
-->
<resources>

    <style name="Theme.CircleOS" parent="@android:style/Theme.DeviceDefault">
        <item name="android:colorPrimary">@color/circle_deep</item>
        <item name="android:colorAccent">@color/circle_gold</item>
        <item name="android:colorBackground">@color/circle_warm</item>
        <item name="android:textColorPrimary">@color/circle_ink</item>
        <item name="android:textColorSecondary">@color/circle_smoke</item>
        <item name="android:colorControlActivated">@color/circle_focus</item>
        <item name="android:colorControlHighlight">@color/circle_focus</item>

        <!-- Type face. Comfortaa, falling back to system sans-serif if the
             font file is missing in early-boot fonts/. -->
        <item name="android:fontFamily">@font/comfortaa</item>

        <!-- Shape -->
        <item name="android:windowBackground">@color/circle_warm</item>
    </style>

    <!-- Variant for the system shell (system UI / dialer / launcher) -->
    <style name="Theme.CircleOS.System" parent="Theme.CircleOS">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/circle_deep</item>
        <item name="android:navigationBarColor">@color/circle_deep</item>
    </style>

    <!-- Variant for the Elder tier: scales touch targets and type up.
         Pulled in by CirclePersonalityService when the tier is ELDER. -->
    <style name="Theme.CircleOS.Elder" parent="Theme.CircleOS">
        <!-- Override sizes in the corresponding values-elder/ folder. -->
    </style>

</resources>
