<?xml version="1.0" encoding="utf-8"?>
<!--
  Comfortaa font family.

  The TTF files (regular / light / medium / semibold / bold) are
  bundled at /system/fonts/Comfortaa-*.ttf by the design system's
  Android.bp PRODUCT_COPY_FILES (to be added — TTFs not yet vendored).
  Until they land, Android falls back to the system sans-serif, which
  is acceptable for v0.

  Variable-font axes are not used; we ship the five static weights so
  we work on older renderers.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:fontStyle="normal"
        android:fontWeight="300"
        android:font="@font/comfortaa_light" />
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/comfortaa_regular" />
    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:font="@font/comfortaa_medium" />
    <font
        android:fontStyle="normal"
        android:fontWeight="600"
        android:font="@font/comfortaa_semibold" />
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/comfortaa_bold" />
</font-family>
